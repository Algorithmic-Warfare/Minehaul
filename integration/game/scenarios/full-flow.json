      "expected": {
        "status": "Resolved",
        "awardToHauler": false,
        "events": ["ActionListed", "ActionClaimed", "AdapterRevoked", "ActionDisputed", "ActionResolved"],
        "rejectedSteps": 1,
        "escrow": { "reward": 0, "collateral": 0, "cargo": 0 },
        "balances": [
          { "step": "resolve", "owner": "lister", "assetId": 0, "amount": 100 },
          { "step": "resolve", "owner": "lister", "assetId": 1, "amount": 25 },
          { "step": "resolve", "owner": "arbiter", "assetId": 0, "amount": 1300 }
        ]
      }
