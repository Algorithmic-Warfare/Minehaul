        "escrow": { "reward": 0, "collateral": 0, "cargo": 0 },
        "balances": [
          { "step": "resolve", "owner": "lister", "assetId": 0, "amount": 100 },
          { "step": "resolve", "owner": "lister", "assetId": 1, "amount": 25 },
          { "step": "resolve", "owner": "arbiter", "assetId": 0, "amount": 1300 }
        ]
      }
    },
    {
      "name": "pause-rejects-admission",
      "steps": [
        { "op": "list" },
        { "op": "pause", "actor": "lister", "value": true },
        { "op": "claim", "actor": "hauler", "expectAbort": 2 },
        { "op": "pause", "actor": "lister", "value": false },
        { "op": "cancel", "actor": "lister" }
      ],
      "expected": {
        "status": "Cancelled",
        "events": ["ActionListed", "ActionCancelled"],
