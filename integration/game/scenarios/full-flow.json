  "acceptanceScenarios": [
    {
      "name": "successful-settlement",
      "steps": [
        { "op": "list" },
        { "op": "claim", "actor": "hauler" },
        { "op": "collect", "actor": "hauler" },
        { "op": "deliver", "actor": "hauler", "receiver": "lister", "destination": "destination" },
        { "op": "settle", "actor": "arbiter" }
      ],
      "expected": {
        "status": "Settled",
        "events": ["ActionListed", "ActionClaimed", "ActionDelivered", "ActionSettled"],
        "escrow": { "reward": 0, "collateral": 0, "cargo": 0 },
        "balances": [
          { "step": "deliver", "owner": "lister", "assetId": 1, "amount": 25 },
          { "step": "settle", "owner": "hauler", "assetId": 0, "amount": 1200 },
          { "step": "settle", "owner": "arbiter", "assetId": 0, "amount": 200 }
        ]
      }
    },
    {
      "name": "cancel-before-claim",
      "steps": [
        { "op": "list" },
        { "op": "cancel", "actor": "lister" }
      ],
      "expected": {
        "status": "Cancelled",
        "events": ["ActionListed", "ActionCancelled"],
        "escrow": { "reward": 0, "collateral": 0, "cargo": 0 },
        "balances": [
          { "step": "cancel", "owner": "lister", "assetId": 0, "amount": 1000 },
          { "step": "cancel", "owner": "lister", "assetId": 1, "amount": 25 }
        ]
      }
    },
    {
      "name": "expire-unclaimed",
      "config": { "listingTtlMs": 100 },
      "steps": [
        { "op": "list" },
        { "op": "wait-listing-deadline" },
        { "op": "expire", "actor": "arbiter" }
      ],
      "expected": {
        "status": "Expired",
        "events": ["ActionListed", "ActionExpired"],
        "escrow": { "reward": 0, "collateral": 0, "cargo": 0 },
