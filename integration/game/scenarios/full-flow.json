      "steps": [
        { "op": "list" },
        { "op": "claim", "actor": "hauler" },
        { "op": "claim", "actor": "arbiter", "expectAbort": 6 },
        { "op": "collect", "actor": "hauler" },
        { "op": "deliver", "actor": "hauler", "receiver": "lister", "destination": "destination" },
        { "op": "settle", "actor": "arbiter" }
      ],
      "expected": {
        "status": "Settled",
        "events": ["ActionListed", "ActionClaimed", "ActionDelivered", "ActionSettled"],
