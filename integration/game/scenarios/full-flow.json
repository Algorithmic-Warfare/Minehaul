      "steps": [
        { "op": "list" },
        { "op": "claim", "actor": "hauler" },
        { "op": "collect", "actor": "hauler" },
        { "op": "dispute", "actor": "lister" },
        { "op": "resolve", "actor": "lister", "awardToHauler": false, "slashBps": 2500 },
        { "op": "resolve", "actor": "lister", "awardToHauler": false, "slashBps": 2500, "expectAbort": 6 }
      ],
      "expected": {
        "status": "Resolved",
        "awardToHauler": false,
        "events": ["ActionListed", "ActionClaimed", "ActionDisputed", "ActionResolved"],
        "eventCounts": { "ActionResolved": 1 },
