          { "step": "expire", "owner": "lister", "assetId": 0, "amount": 1000 },
          { "step": "expire", "owner": "lister", "assetId": 1, "amount": 25 }
        ]
      }
    },
    {
      "name": "expire-after-claim",
      "config": { "haulTtlMs": 1000 },
      "steps": [
        { "op": "list" },
        { "op": "claim", "actor": "hauler" },
        { "op": "wait-haul-deadline" },
        { "op": "expire", "actor": "arbiter" }
      ],
      "expected": {
        "status": "Disputed",
        "events": ["ActionListed", "ActionClaimed", "ActionDisputed", "ActionExpired"],
        "escrow": { "reward": 1000, "collateral": 400, "cargo": 25 }
      }
    },
    {
      "name": "expire-after-collection",
      "config": { "haulTtlMs": 1000 },
      "steps": [
        { "op": "list" },
        { "op": "claim", "actor": "hauler" },
        { "op": "collect", "actor": "hauler" },
        { "op": "wait-haul-deadline" },
        { "op": "expire", "actor": "arbiter" }
      ],
      "expected": {
        "status": "Disputed",
        "events": ["ActionListed", "ActionClaimed", "ActionDisputed", "ActionExpired"],
        "escrow": { "reward": 1000, "collateral": 400, "cargo": 25 }
      }
