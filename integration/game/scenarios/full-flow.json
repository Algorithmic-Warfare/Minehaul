      "expected": {
        "status": "Settled",
        "events": ["ActionListed", "ActionClaimed", "ActionDelivered", "ActionSettled"],
        "eventCounts": { "ActionDelivered": 1, "ActionSettled": 1 },
        "rejectedSteps": 3,
        "escrow": { "reward": 0, "collateral": 0, "cargo": 0 },
        "balances": [
          { "step": "deliver", "owner": "lister", "assetId": 1, "amount": 25 },
          { "step": "settle", "owner": "hauler", "assetId": 0, "amount": 1200 },
          { "step": "settle", "owner": "arbiter", "assetId": 0, "amount": 200 }
        ]
      }
    },
    {
      "name": "adapter-revocation",
      "steps": [
        { "op": "list" },
        { "op": "claim", "actor": "hauler" },
        { "op": "collect", "actor": "hauler" },
        { "op": "revoke-delivery-adapter", "actor": "lister" },
        { "op": "deliver", "actor": "hauler", "receiver": "lister", "destination": "destination", "expectAbort": 18 },
        { "op": "dispute", "actor": "lister" },
        { "op": "resolve", "actor": "lister", "awardToHauler": false, "slashBps": 2500 }
