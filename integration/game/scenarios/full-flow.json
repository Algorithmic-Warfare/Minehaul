        { "op": "list" },
        { "op": "claim", "actor": "hauler" },
        { "op": "collect", "actor": "hauler" },
        { "op": "dispute", "actor": "lister" }
      ],
      "expected": {
        "status": "Disputed",
        "events": ["ActionListed", "ActionClaimed", "ActionDisputed"],
        "escrow": { "reward": 1000, "collateral": 400, "cargo": 25 }
      }
    },
    {
      "name": "dispute-after-delivery",
      "config": { "disputeWindowMs": 600000 },
      "steps": [
        { "op": "list" },
        { "op": "claim", "actor": "hauler" },
        { "op": "collect", "actor": "hauler" },
        { "op": "deliver", "actor": "hauler", "receiver": "lister", "destination": "destination" },
        { "op": "dispute", "actor": "lister" }
